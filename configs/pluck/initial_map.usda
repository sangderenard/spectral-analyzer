#usda 1.0
(
    defaultPrim = "PluckWorld"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "PluckWorld"
{
    custom bool pluck:movementEnforced = 0
    custom token pluck:movementPolicy = "room-authority-bounded"
    custom rel pluck:roomAuthority = </PluckWorld/Objects/room_station_492f28>
    custom string pluck:roomMaterialBindings = '{"ceiling":"acoustic_plaster_ceiling","floor":"stage_floor","floor_fill":"stage_floor","floor_tile":"pearl_white_tile","walls":"painted_plaster_wall"}'
    custom token pluck:sceneRole = "general-initial-map"
    custom int pluck:schemaVersion = 1

    def Scope "Objects"
    {
        def Xform "room_station_492f28" (
            prepend apiSchemas = ["MaterialBindingAPI"]
            prepend references = @objects/room_station_492f28.usda@</PlacedObject>
        )
        {
            rel material:binding = </PluckMaterials/Materials/basic_paneling>
            custom string pluck:materialBindings = '{"body":"basic_paneling","screen":"basic_led_display"}'
            custom double pluck:worldYawDegrees = 0
            float xformOp:rotateZ = 0
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
        }

        def Xform "fabricator_e0b76e" (
            prepend apiSchemas = ["MaterialBindingAPI"]
            prepend references = @objects/fabricator_e0b76e.usda@</PlacedObject>
        )
        {
            rel material:binding = </PluckMaterials/Materials/basic_paneling>
            custom string pluck:materialBindings = '{"body":"basic_paneling","screen":"basic_led_display"}'
            custom double pluck:worldYawDegrees = 0
            float xformOp:rotateZ = 0
            double3 xformOp:translate = (2, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
        }

        def Xform "camera_station_475468" (
            prepend apiSchemas = ["MaterialBindingAPI"]
            prepend references = @objects/camera_station_475468.usda@</PlacedObject>
        )
        {
            rel material:binding = </PluckMaterials/Materials/basic_paneling>
            custom string pluck:materialBindings = '{"body":"basic_paneling","screen":"basic_led_display"}'
            custom double pluck:worldYawDegrees = 0
            float xformOp:rotateZ = 0
            double3 xformOp:translate = (-2, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
        }

        def Xform "camera_display_jar_2bebcd" (
            prepend apiSchemas = ["MaterialBindingAPI"]
            prepend references = @objects/camera_display_jar_2bebcd.usda@</PlacedObject>
        )
        {
            rel material:binding = </PluckMaterials/Materials/borosilicate_glass>
            custom string pluck:materialBindings = '{"glass":"borosilicate_glass","skirt":"stage_floor"}'
            custom double pluck:worldYawDegrees = 0
            float xformOp:rotateZ = 0
            double3 xformOp:translate = (-2, 1.35, 0.72)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
        }

        def Xform "camera_specimen_237b6a" (
            prepend apiSchemas = ["MaterialBindingAPI"]
            prepend references = @objects/camera_specimen_237b6a.usda@</PlacedObject>
        )
        {
            rel material:binding = </PluckMaterials/Materials/basic_paneling>
            custom string pluck:materialBindings = '{"body":"basic_paneling"}'
            custom double pluck:worldYawDegrees = 0
            float xformOp:rotateZ = 0
            double3 xformOp:translate = (-2, 1.35, 0.82)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
        }
    }
}

def Scope "PluckMaterials"
{
    def Scope "Materials"
    {
        def Material "basic_paneling"
        {
            token outputs:surface.connect = </PluckMaterials/Materials/basic_paneling/PreviewSurface.outputs:surface>
            custom token pluck:authority = "canonical-project-material"
            custom asset pluck:definitionAsset = @../materials/basic_paneling.yaml@
            custom token[] pluck:engineRequirements = []
            custom string pluck:materialKey = "basic_paneling"
            custom string pluck:materialRevision = "af5914832882069debc9dfffd1e25fdcf7455707bbf4dbbe0f1cc46afc13f752"
            custom token pluck:projectionKind = "portable-preview"

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5, 0.5, 0.5)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

